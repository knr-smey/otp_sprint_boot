# Copy this file to `.env` and adjust only what you need to override.
# Defaults already match this machine (see below), so most people won't need a .env.

# --- Port layout on this machine --------------------------------------------
# 3306/3307/3308  other projects' MySQL containers (etec, system, learn)
# 8082            another project's phpMyAdmin web UI (learn_phpmyadmin) - NOT MySQL
# 8080            etec_backend -> so this API defaults to 8081

# --- docker-compose.yml (host port mappings) ---
#DB_PORT=3309      # host port for THIS project's MySQL container
#PMA_PORT=8083     # host port for THIS project's phpMyAdmin UI

# --- application.properties (Spring Boot datasource / server) ---
#DB_HOST=localhost
#DB_NAME=2fadb
#DB_USERNAME=root
#DB_PASSWORD=
#SERVER_PORT=8081
