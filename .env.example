# Copy this file to `.env` and adjust only what you need to override.
# Defaults (root user, no password, port 3306) already match a fresh
# XAMPP install and the default `docker compose up -d`, so most people
# won't need a `.env` at all.

# --- Used by docker-compose.yml (host port mapping) ---
# Change if 3306/8081 are already taken on your machine by another project.
#DB_PORT=3306
#PMA_PORT=8081

# --- Used by application.properties (Spring Boot datasource) ---
#DB_HOST=localhost
#DB_NAME=spring_boot_project_api
#DB_USERNAME=root
#DB_PASSWORD=
